{
    "scene_understanding_backend": "smolvlm",
    "scene_understanding_prompt": "smolvlm+prompt.txt",
    "grounding_backend": "locate_anything",
    "segmentation_backend": "sam2",

    "download_random_frames": true,
    "run_scene_understanding": true,
    "run_ontology_reasoning": false,
    "run_prompt_builder": false,
    "run_grounding": false,
    "run_segmentation": false,
    "run_annotation": false,
    "save_intermediate_cache": true,
    "save_pipeline_cache": true,
    "save_raw_outputs": false,
    "save_visualizations": true,

    "num_images": 100,
    "interval_seconds": 10,
    "confidence_threshold": 0.30,
    "max_objects_per_image": 50,

    "benchmark": false,
    "logger_level": "info",




    
    "frames": "data",
    "videos": "videos",
    "mapping": "mapping.csv",

    "base_url": "https://files.mobility-squad.com/",
    "delete_downloaded_videos": true,

    "local_output_root": "random_frames",

    "DAY_NIGHTS": [
        "Day",
        "Night"
    ],

    "VEHICLES": [
        "Car",
        "Bus",
        "Truck"
    ],

    "VIDEO_IDS": [],

    "LOCATION_TREE": {
        "Asia": {
        "India": {
            "DL": ["New Delhi","Old Delhi"],
            "KA": ["Bengaluru"]
        },
        "Japan": {
            "Tokyo": ["Tokyo"]
        }
        },
        "Europe": {
        "Netherlands": {
            "unknown": ["Eindhoven","Tilburg", "Amsterdam"]
        },
        "Germany": {
            "unknown": ["München"]
        }}},


    "scene_understanding": {
            "gemma_model_id": "google/gemma-3-4b-it",  
            "smolvlm_model_id": "HuggingFaceTB/SmolVLM2-500M-Video-Instruct"
        },

    "ontology_reasoning": {

        "embedding": {
            "model_id": "BAAI/bge-base-en-v1.5"
        },

        "save_index": true,
        "rebuild_index": false
    },

    "grounding": {
        "locate_anything_model_id": "nvidia/LocateAnything-3B"
    },

    "segmentation": {
        "sam2_model_id": "sam2.1_hiera_large"
    }
}