{
    "project": {
        "name": "TraffCOCO annotation",
        "version": "0.1.0",
        "description": "A modular traffic scene understanding framework combining Vision-Language Models, knowledge graphs, grounding, and segmentation for automated dataset annotation."
    },

    "frames": "data",
    "videos": "videos",
    "mapping": "mapping.csv",
    "interval_seconds": 10,
    "base_url": "https://files.mobility-squad.com/",
    "delete_downloaded_videos": true,
    "logger_level": "info",
    "num_images": 100,
    "local_output_root": "random_frames",
    "DAY_NIGHTS": ["Day","Night"],
    "VEHICLES": ["Car","Bus","Truck"],
    "VIDEO_IDS": [],

    "LOCATION_TREE": {
        "Asia": {
        "India": {
            "DL": ["New Delhi","Old Delhi"],
            "KA": ["Bengaluru"]
        },
        "Japan": {
            "Tokyo": ["Tokyo"]
        }
        },
        "Europe": {
        "Netherlands": {
            "unknown": ["Eindhoven","Tilburg", "Amsterdam"]
        },
        "Germany": {
            "unknown": ["München"]
        }}},

    "annotation_pipeline":{
        
        "paths": {
            "project_root": ".",
            "random_frames": "random_frames",
            "ontology": "annotation_pipeline/common/ontology/traffic_ontology_v2.json",
            "prompts": "annotation_pipeline/common/prompts",
            "outputs": "annotation_pipeline/vlm_first/outputs",
            "scene_cache": "annotation_pipeline/vlm_first/outputs/scene_cache",
            "pipeline_cache": "annotation_pipeline/vlm_first/outputs/pipeline_cache",
            "visualizations": "annotation_pipeline/vlm_first/outputs/visualizations",
            "masks": "annotation_pipeline/vlm_first/outputs/masks",
            "annotations": "annotation_pipeline/vlm_first/outputs/annotations",
            "logs": "annotation_pipeline/vlm_first/outputs/logs"  
        },

        "models": {

            "scene_understanding": {

                "backend": "smolvlm",

                "prompt": "smolvlm+prompt.txt",

                "models": {

                    "gemma": {

                        "model_id": "google/gemma-3-4b-it",
                        "device": "cuda",
                        "dtype": "bfloat16",
                        "attention": "flash_attention_2",
                        "trust_remote_code": false,
                        "compile": false,
                        "quantization": null,
                        "do_sample": false,
                        "max_new_tokens": 2048,
                        "temperature": 0.1
                    },

                    "smolvlm": {

                        "model_id": "HuggingFaceTB/SmolVLM2-500M-Video-Instruct",
                        "device": "cpu",
                        "dtype": "float32",
                        "attention": "sdpa",
                        "trust_remote_code": false,
                        "compile": false,
                        "quantization": null,
                        "do_sample": false,
                        "max_new_tokens": 2048,
                        "temperature": 0.1
                    }
                }
            },

            "ontology_reasoning": {

                "embedding": {

                    "model_id": "BAAI/bge-base-en-v1.5",
                    "device": "cuda",
                    "normalize_embeddings": true,
                    "top_k": 10
                },

                "ranking": {

                    "embedding_weight": 0.60,
                    "keyword_weight": 0.10,
                    "shape_weight": 0.10,
                    "context_weight": 0.10,
                    "color_weight": 0.05,
                    "purpose_weight": 0.05,
                    "negative_penalty": 0.20
                },

                "save_index": true,
                "rebuild_index": false
            },

            "grounding": {

                "backend": "locate_anything",

                "models": {

                    "locate_anything": {

                        "model_id": "nvidia/LocateAnything-3B",
                        "device": "cuda",
                        "coordinate_scale": 1000
                    }
                }
            },

            "segmentation": {

                "backend": "sam2",

                "models": {

                    "sam2": {

                        "model_id": "sam2.1_hiera_large",
                        "device": "cuda",
                        "checkpoint": null,
                        "config": null,
                        "multimask_output": false
                    }
                }
            }
        },

        "pipeline": {

            "confidence_threshold": 0.30,
            "max_objects_per_image": 50,
            
            "download_random_frames": true,
            "run_scene_understanding": true,
            "run_ontology_reasoning": false,
            "run_prompt_builder": false,
            "run_grounding": false,
            "run_segmentation": false,
            "run_annotation": false,
        

            "save_intermediate_cache": true,
            "save_pipeline_cache": true,
            "save_raw_outputs": false,
            "save_visualizations": true,

            "benchmark": false,

            "supported_image_extensions": [
                ".png",
                ".jpg",
                ".jpeg",
                ".bmp",
                ".tiff"
            ]
        },

        "logging": {

            "level": "INFO",
            "log_to_file": true,
            "log_filename": "pipeline.log",
            "format": "%(asctime)s | %(name)-35s | %(levelname)-8s | %(message)s",
            "date_format": "%Y-%m-%d %H:%M:%S"
        }
    }
}